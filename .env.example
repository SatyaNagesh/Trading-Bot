# QuantLab paper integration — ENV NAMES ONLY
# Values live ONLY in Render secret store + shell env. This file is the name checklist.
QUANTLAB_PAPER_ONLY=true
QUANTLAB_PAPER_TRADING=true
QUANTLAB_LIVE_TRADING_ENABLED=false
QUANTLAB_LIVE_GUARD=true
QUANTLAB_LIVE_BROKER_URL=          # must stay EMPTY (live hard-blocked)
QUANTLAB_DISCORD_ENABLED=true
QUANTLAB_DISCORD_BOT_TOKEN=         # from Render secret store (Bot HTTP REST API)
QUANTLAB_DISCORD_CHANNEL_ID=        # from Render secret store (fixed operator channel)
QUANTLAB_TV_WEBHOOK_ENABLED=true
QUANTLAB_WEBHOOK_SECRET=             # from Render secret store (code reads exactly QUANTLAB_WEBHOOK_SECRET)
QUANTLAB_TV_SECRET_HEADER=X-QuantLab-Webhook-Token   # header NAME only, no value
