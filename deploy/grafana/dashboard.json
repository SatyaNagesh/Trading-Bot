{"title": "QuantLab AI — Service Overview", "__inputs": [{"name": "DS_PROMETHEUS", "label": "Prometheus", "type": "datasource"}], "panels": [{"title": "Request Rate", "type": "timeseries", "datasource": "${DS_PROMETHEUS}", "targets": [{"expr": "sum(rate(quantlab_requests_total[5m])) by (service)"}]}, {"title": "P99 Latency", "type": "timeseries", "datasource": "${DS_PROMETHEUS}", "targets": [{"expr": "histogram_quantile(0.99, sum(rate(quantlab_request_duration_seconds_bucket[5m])) by (le, service))"}]}, {"title": "Active Orders", "type": "stat", "datasource": "${DS_PROMETHEUS}", "targets": [{"expr": "quantlab_active_orders"}]}, {"title": "Memory by Tier", "type": "barchart", "datasource": "${DS_PROMETHEUS}", "targets": [{"expr": "quantlab_memory_entries"}]}, {"title": "Error Rate", "type": "timeseries", "datasource": "${DS_PROMETHEUS}", "targets": [{"expr": "sum(rate(quantlab_errors_total[5m])) by (service)"}]}, {"title": "Model Predictions", "type": "timeseries", "datasource": "${DS_PROMETHEUS}", "targets": [{"expr": "sum(rate(quantlab_model_predictions_total[5m])) by (model)"}]}, {"title": "CPU Usage", "type": "timeseries", "datasource": "${DS_PROMETHEUS}", "targets": [{"expr": "sum(rate(container_cpu_usage_seconds_total{namespace=\"quantlab\"}[5m])) by (pod)"}]}, {"title": "Memory Usage", "type": "timeseries", "datasource": "${DS_PROMETHEUS}", "targets": [{"expr": "sum(container_memory_working_set_bytes{namespace=\"quantlab\"}) by (pod)"}]}]}
